#!/bin/bash

# omarchy:summary=Print system activity stats for the shell
# omarchy:group=system
# omarchy:args=[--bar-widget|--activity-reader|--activity-resources|--activity-processes|--activity-thermals|--activity-gpus|--activity-process-power|--activity-process-power-reader|--activity-storage]

bar_widget_stats() {
  awk '
    NR == 1 {
      idle = $5
      total = 0
      for (i = 2; i <= NF; i++) total += $i
      printf "cpu\t%s\t%s\n", idle, total
    }
  ' /proc/stat

  awk '
    /^MemTotal:/ { total = $2 }
    /^MemAvailable:/ { avail = $2 }
    END {
      if (total > 0) printf "memory\t%.2f\n", ((total - avail) / total) * 100
    }
  ' /proc/meminfo

  awk '{ print "load\t" $1 }' /proc/loadavg
}

activity_temperature_sensor_cache=""
activity_temperature_chip_cache=""
activity_temperature_label_cache=""
activity_temperature_sys_path_cache=""

activity_temperature_rows() {
  local sys_path="$1"
  local hwmon input sensor_id label_file
  local chip chip_lower label label_lower value rank
  local best_sensor="" best_chip="" best_label="" best_value="0" best_rank="100"

  # The CPU sensor topology is effectively static during a desktop session.
  # Reuse the selected sysfs input in reader mode and rescan only if it
  # disappears or stops returning a sane temperature.
  if [[ $activity_temperature_sys_path_cache == "$sys_path" &&
        -n $activity_temperature_sensor_cache ]]; then
    input="$sys_path/class/hwmon/$activity_temperature_sensor_cache"
    if [[ -r $input ]] &&
        read -r value <"$input" 2>/dev/null &&
        [[ $value =~ ^-?[0-9]+$ ]] &&
        (( value > 0 && value < 150000 )); then
      printf 'temperature\t%s\t%s\t%s\t%s\n' \
        "${activity_temperature_sensor_cache%_input}" \
        "$activity_temperature_chip_cache" \
        "$activity_temperature_label_cache" \
        "$value"
      return 0
    fi
    activity_temperature_sensor_cache=""
    activity_temperature_chip_cache=""
    activity_temperature_label_cache=""
    activity_temperature_sys_path_cache=""
  fi

  for hwmon in "$sys_path"/class/hwmon/hwmon*; do
    [[ -d $hwmon ]] || continue
    chip="unknown"
    [[ -r $hwmon/name ]] && read -r chip <"$hwmon/name" 2>/dev/null
    chip_lower="${chip,,}"

    for input in "$hwmon"/temp*_input; do
      [[ -r $input ]] || continue
      read -r value <"$input" 2>/dev/null || continue
      [[ $value =~ ^-?[0-9]+$ ]] || continue
      (( value > 0 && value < 150000 )) || continue

      label_file="${input%_input}_label"
      label="$chip"
      [[ -r $label_file ]] && read -r label <"$label_file" 2>/dev/null
      label_lower="${label,,}"
      rank=100
      if [[ $chip_lower == "coretemp" && $label_lower == *"package id"* ]]; then
        rank=0
      elif [[ $chip_lower == "k10temp" && $label_lower == "tctl" ]]; then
        rank=1
      elif [[ $label_lower == *"cpu"* || $label_lower == *"package"* || $label_lower == "tctl" ]]; then
        rank=2
      elif [[ $chip_lower == "coretemp" || $chip_lower == "k10temp" ]]; then
        rank=3
      fi
      (( rank < 100 )) || continue
      if (( rank < best_rank || (rank == best_rank && value > best_value) )); then
        sensor_id="${input%_input}"
        best_sensor="${sensor_id#"$sys_path"/class/hwmon/}"
        best_chip="$chip"
        best_label="$label"
        best_value="$value"
        best_rank="$rank"
      fi
    done
  done

  (( best_rank < 100 )) || return 0
  best_chip="${best_chip//$'\t'/ }"
  best_chip="${best_chip//$'\r'/ }"
  best_label="${best_label//$'\t'/ }"
  best_label="${best_label//$'\r'/ }"
  activity_temperature_sensor_cache="${best_sensor}_input"
  activity_temperature_chip_cache="$best_chip"
  activity_temperature_label_cache="$best_label"
  activity_temperature_sys_path_cache="$sys_path"
  printf 'temperature\t%s\t%s\t%s\t%s\n' \
    "$best_sensor" "$best_chip" "$best_label" "$best_value"
}

activity_thermal_stats() {
  local proc_path="${OMARCHY_SYSTEM_STATS_PROC_PATH:-/proc}"
  local sys_path="${OMARCHY_SYSTEM_STATS_SYS_PATH:-/sys}"
  local sample="0"
  [[ -r $proc_path/uptime ]] && read -r sample _ <"$proc_path/uptime"

  printf 'schema\tactivity-thermals\t1\n'
  printf 'sample\t%s\n' "$sample"
  activity_temperature_rows "$sys_path"
}

activity_storage_stats() {
  local proc_path="${OMARCHY_SYSTEM_STATS_PROC_PATH:-/proc}"
  local storage_path="${OMARCHY_SYSTEM_STATS_ROOT_PATH:-/}"
  local sample="0"
  local stat_fields block_size blocks free_blocks available_blocks
  local used_blocks total_bytes used_bytes available_bytes

  [[ -r $proc_path/uptime ]] && read -r sample _ <"$proc_path/uptime"
  printf 'schema\tactivity-storage\t1\n'
  printf 'sample\t%s\n' "$sample"

  # A single statfs call provides internally consistent capacity figures.
  # Use free blocks to calculate used space, while available blocks reflects
  # what an unprivileged desktop user can still allocate.
  stat_fields=$(LC_ALL=C stat -f -c $'%S\t%b\t%f\t%a' -- "$storage_path" 2>/dev/null) ||
    return 0
  IFS=$'\t' read -r block_size blocks free_blocks available_blocks <<<"$stat_fields"
  [[ $block_size =~ ^[0-9]+$ && $blocks =~ ^[0-9]+$ ]] || return 0
  [[ $free_blocks =~ ^[0-9]+$ && $available_blocks =~ ^[0-9]+$ ]] || return 0
  (( block_size > 0 )) || return 0

  (( free_blocks > blocks )) && free_blocks="$blocks"
  (( available_blocks > blocks )) && available_blocks="$blocks"
  used_blocks=$((blocks - free_blocks))
  total_bytes=$((block_size * blocks))
  used_bytes=$((block_size * used_blocks))
  available_bytes=$((block_size * available_blocks))
  printf 'storage\t/\t%s\t%s\t%s\n' \
    "$total_bytes" "$used_bytes" "$available_bytes"
}

declare -A activity_gpu_name_cache=()
activity_gpu_name_result=""
activity_gpu_frequency_result="-1"

activity_trim_field() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  value="${value//$'\t'/ }"
  value="${value//$'\n'/ }"
  value="${value//$'\r'/ }"
  printf '%s' "$value"
}

activity_gpu_vendor_name() {
  case "${1,,}" in
    8086) printf 'Intel' ;;
    1002) printf 'AMD' ;;
    10de) printf 'NVIDIA' ;;
    *) printf 'GPU' ;;
  esac
}

activity_gpu_name() {
  local id="$1"
  local device_path="$2"
  local vendor_name="$3"
  local name="" description=""

  if [[ -n ${activity_gpu_name_cache[$id]+cached} ]]; then
    activity_gpu_name_result="${activity_gpu_name_cache[$id]}"
    return 0
  fi

  if [[ -r $device_path/product_name ]]; then
    read -r name <"$device_path/product_name" 2>/dev/null || name=""
  fi
  if [[ -z $name && $id =~ ^[[:xdigit:]]{4}:[[:xdigit:]]{2}:[[:xdigit:]]{2}\.[[:xdigit:]]$ ]] &&
      command -v lspci >/dev/null 2>&1; then
    description=$(LC_ALL=C lspci -D -s "$id" 2>/dev/null) || description=""
    description="${description%%$'\n'*}"
    [[ $description == *": "* ]] && name="${description#*: }"
    if [[ $name =~ ^(.*)[[:space:]]+\(rev[[:space:]]+[[:xdigit:]]+\)$ ]]; then
      name="${BASH_REMATCH[1]}"
    fi
  fi
  [[ -n $name ]] || name="$vendor_name GPU"
  name=$(activity_trim_field "$name")
  activity_gpu_name_cache["$id"]="$name"
  activity_gpu_name_result="$name"
}

activity_gpu_max_frequency_paths() {
  local divisor="$1"
  shift
  local path value mhz
  local best="-1"

  for path in "$@"; do
    [[ -r $path ]] || continue
    read -r value <"$path" 2>/dev/null || continue
    value=$(activity_trim_field "$value")
    [[ $value =~ ^[0-9]+$ ]] || continue
    mhz=$((value / divisor))
    (( mhz > best )) && best="$mhz"
  done

  activity_gpu_frequency_result="$best"
}

activity_gpu_frequency() {
  local card="$1"
  local device_path="$2"
  local vendor_hex="$3"
  local line

  activity_gpu_frequency_result="-1"
  case "$vendor_hex" in
    8086)
      # Xe exposes the measured clock per GT. Older i915 generations expose
      # the same value through their RPS or card-level frequency files.
      activity_gpu_max_frequency_paths 1 \
        "$device_path"/tile*/gt*/freq*/act_freq \
        "$card"/gt/gt*/rps_act_freq_mhz \
        "$card"/gt_act_freq_mhz
      if (( activity_gpu_frequency_result < 0 )); then
        activity_gpu_max_frequency_paths 1 \
          "$device_path"/tile*/gt*/freq*/cur_freq \
          "$card"/gt/gt*/rps_cur_freq_mhz \
          "$card"/gt_cur_freq_mhz
      fi
      ;;
    1002)
      # amdgpu's first hwmon frequency is the graphics clock in Hz.
      activity_gpu_max_frequency_paths 1000000 \
        "$device_path"/hwmon/hwmon*/freq1_input
      if (( activity_gpu_frequency_result < 0 )) && [[ -r $device_path/pp_dpm_sclk ]]; then
        while IFS= read -r line; do
          if [[ $line == *"*"* &&
                $line =~ ([0-9]+)([.][0-9]+)?[[:space:]]*[Mm][Hh][Zz] ]]; then
            activity_gpu_frequency_result="${BASH_REMATCH[1]}"
            break
          fi
        done <"$device_path/pp_dpm_sclk"
      fi
      ;;
  esac

  # devfreq and hwmon cover additional DRM drivers without vendor-specific
  # handling. Values are reported in Hz.
  if (( activity_gpu_frequency_result < 0 )); then
    activity_gpu_max_frequency_paths 1000000 \
      "$device_path"/devfreq/*/cur_freq \
      "$device_path"/hwmon/hwmon*/freq1_input
  fi
}

activity_gpu_stats() {
  local proc_path="${OMARCHY_SYSTEM_STATS_PROC_PATH:-/proc}"
  local sys_path="${OMARCHY_SYSTEM_STATS_SYS_PATH:-/sys}"
  local sample="0"
  local card card_name device_path device_real id vendor_hex vendor_name
  local driver_path driver name value used total kind
  local has_nvidia=0 nvidia_output bus utilization used_mib total_mib clock_mhz
  local known_ids fdinfo
  local -a gpu_order=() fdinfo_files=()
  local -A gpu_seen=() gpu_vendor=() gpu_driver=() gpu_name=()
  local -A gpu_utilization=() gpu_memory_used=() gpu_memory_total=()
  local -A gpu_memory_kind=() gpu_frequency=()

  [[ -r $proc_path/uptime ]] && read -r sample _ <"$proc_path/uptime"
  printf 'schema\tactivity-gpus\t1\n'
  printf 'sample\t%s\n' "$sample"

  for card in "$sys_path"/class/drm/card[0-9]*; do
    card_name="${card##*/}"
    [[ $card_name =~ ^card[0-9]+$ && -e $card/device ]] || continue
    device_path="$card/device"
    device_real=$(readlink -f -- "$device_path" 2>/dev/null) || device_real="$device_path"
    id="${device_real##*/}"
    [[ $id =~ ^[[:xdigit:]]{4}:[[:xdigit:]]{2}:[[:xdigit:]]{2}\.[[:xdigit:]]$ ]] || id="$card_name"
    id="${id,,}"
    [[ -z ${gpu_seen[$id]+seen} ]] || continue

    vendor_hex=""
    [[ -r $device_path/vendor ]] && read -r vendor_hex <"$device_path/vendor" 2>/dev/null
    vendor_hex="${vendor_hex#0x}"
    vendor_hex="${vendor_hex,,}"
    vendor_name=$(activity_gpu_vendor_name "$vendor_hex")

    driver=""
    driver_path=$(readlink -f -- "$device_path/driver" 2>/dev/null) || driver_path=""
    [[ -n $driver_path ]] && driver="${driver_path##*/}"
    if [[ -z $driver && -r $device_path/uevent ]]; then
      while IFS='=' read -r value used; do
        if [[ $value == "DRIVER" ]]; then
          driver="$used"
          break
        fi
      done <"$device_path/uevent"
    fi
    [[ -n $driver ]] || driver="unknown"
    activity_gpu_name "$id" "$device_path" "$vendor_name"
    name="$activity_gpu_name_result"

    gpu_seen["$id"]=1
    gpu_order+=("$id")
    gpu_vendor["$id"]="$vendor_name"
    gpu_driver["$id"]="$(activity_trim_field "$driver")"
    gpu_name["$id"]="$name"
    gpu_utilization["$id"]="-1"
    gpu_memory_used["$id"]="-1"
    gpu_memory_total["$id"]="-1"
    gpu_memory_kind["$id"]="unknown"
    activity_gpu_frequency "$card" "$device_path" "$vendor_hex"
    gpu_frequency["$id"]="$activity_gpu_frequency_result"
    [[ $vendor_hex == "10de" ]] && has_nvidia=1

    value=""
    [[ -r $device_path/gpu_busy_percent ]] &&
      read -r value <"$device_path/gpu_busy_percent" 2>/dev/null
    if [[ $value =~ ^[0-9]+([.][0-9]+)?$ ]]; then
      gpu_utilization["$id"]="$value"
    fi

    used=""
    total=""
    [[ -r $device_path/mem_info_vram_used ]] &&
      read -r used <"$device_path/mem_info_vram_used" 2>/dev/null
    [[ -r $device_path/mem_info_vram_total ]] &&
      read -r total <"$device_path/mem_info_vram_total" 2>/dev/null
    kind="vram"
    if [[ ! $used =~ ^[0-9]+$ || ! $total =~ ^[0-9]+$ || $total == 0 ]]; then
      used=""
      total=""
      [[ -r $device_path/mem_info_gtt_used ]] &&
        read -r used <"$device_path/mem_info_gtt_used" 2>/dev/null
      [[ -r $device_path/mem_info_gtt_total ]] &&
        read -r total <"$device_path/mem_info_gtt_total" 2>/dev/null
      kind="shared"
    fi
    if [[ $used =~ ^[0-9]+$ && $total =~ ^[0-9]+$ && $total != 0 ]]; then
      (( used > total )) && used="$total"
      gpu_memory_used["$id"]="$used"
      [[ $kind == "vram" ]] && gpu_memory_total["$id"]="$total"
      gpu_memory_kind["$id"]="$kind"
    fi
  done

  if (( !has_nvidia )); then
    for card in "$proc_path"/driver/nvidia/gpus/*; do
      if [[ -d $card ]]; then
        has_nvidia=1
        break
      fi
    done
  fi

  # NVIDIA's supported management interface supplies both whole-GPU busy
  # percentage and framebuffer memory. Query it only when a NVIDIA DRM device
  # or registered NVIDIA device was found, so systems with an unrelated
  # nvidia-smi binary stay cheap.
  if (( has_nvidia )) && command -v nvidia-smi >/dev/null 2>&1; then
    if command -v timeout >/dev/null 2>&1; then
      nvidia_output=$(timeout 3 nvidia-smi \
        --query-gpu=pci.bus_id,name,utilization.gpu,memory.used,memory.total,clocks.current.graphics \
        --format=csv,noheader,nounits 2>/dev/null) || nvidia_output=""
    else
      nvidia_output=$(nvidia-smi \
        --query-gpu=pci.bus_id,name,utilization.gpu,memory.used,memory.total,clocks.current.graphics \
        --format=csv,noheader,nounits 2>/dev/null) || nvidia_output=""
    fi

    while IFS=',' read -r bus name utilization used_mib total_mib clock_mhz; do
      bus=$(activity_trim_field "$bus")
      name=$(activity_trim_field "$name")
      utilization=$(activity_trim_field "$utilization")
      used_mib=$(activity_trim_field "$used_mib")
      total_mib=$(activity_trim_field "$total_mib")
      clock_mhz=$(activity_trim_field "$clock_mhz")
      bus="${bus,,}"
      if [[ $bus =~ ^[[:xdigit:]]{8}:[[:xdigit:]]{2}:[[:xdigit:]]{2}\.[[:xdigit:]]$ ]]; then
        bus="${bus:4}"
      fi
      [[ $bus =~ ^[[:xdigit:]]{4}:[[:xdigit:]]{2}:[[:xdigit:]]{2}\.[[:xdigit:]]$ ]] || continue
      if [[ -z ${gpu_seen[$bus]+seen} ]]; then
        gpu_seen["$bus"]=1
        gpu_order+=("$bus")
      fi
      gpu_vendor["$bus"]="NVIDIA"
      gpu_driver["$bus"]="nvidia"
      [[ -n $name ]] && gpu_name["$bus"]="$name"
      [[ -n ${gpu_name[$bus]:-} ]] || gpu_name["$bus"]="NVIDIA GPU"
      if [[ $utilization =~ ^[0-9]+([.][0-9]+)?$ ]]; then
        gpu_utilization["$bus"]="$utilization"
      fi
      if [[ $used_mib =~ ^[0-9]+$ && $total_mib =~ ^[0-9]+$ && $total_mib != 0 ]]; then
        (( used_mib > total_mib )) && used_mib="$total_mib"
        gpu_memory_used["$bus"]=$((used_mib * 1024 * 1024))
        gpu_memory_total["$bus"]=$((total_mib * 1024 * 1024))
        gpu_memory_kind["$bus"]="vram"
      fi
      if [[ $clock_mhz =~ ^[0-9]+([.][0-9]+)?$ ]]; then
        gpu_frequency["$bus"]="$clock_mhz"
      fi
    done <<<"$nvidia_output"
  fi

  for id in "${gpu_order[@]}"; do
    printf 'gpu\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$id" "${gpu_vendor[$id]:-GPU}" "${gpu_driver[$id]:-unknown}" \
      "${gpu_name[$id]:-GPU}" "${gpu_utilization[$id]:--1}" \
      "${gpu_memory_used[$id]:--1}" "${gpu_memory_total[$id]:--1}" \
      "${gpu_memory_kind[$id]:-unknown}" "${gpu_frequency[$id]:--1}"
  done

  (( ${#gpu_order[@]} > 0 )) || return 0

  if command -v find >/dev/null 2>&1; then
    while IFS= read -r fdinfo; do
      fdinfo="${fdinfo/\/fd\//\/fdinfo\/}"
      [[ -r $fdinfo ]] && fdinfo_files+=("$fdinfo")
    done < <(
      find "$proc_path"/[0-9]*/fd -maxdepth 1 -lname '/dev/dri/*' -print 2>/dev/null
    )
  else
    for fdinfo in "$proc_path"/[0-9]*/fdinfo/[0-9]*; do
      [[ -r $fdinfo ]] && fdinfo_files+=("$fdinfo")
    done
  fi
  (( ${#fdinfo_files[@]} > 0 )) || return 0
  known_ids=$(IFS=,; printf '%s' "${gpu_order[*]}")

  # DRM fdinfo is the portable fallback for Intel/Xe and drivers without a
  # direct utilization file. Duplicate fds expose the same drm-client-id, so
  # count each client once. Memory rows are instantaneous resident allocation;
  # engine rows remain raw cumulative counters for delta calculation in QML.
  printf '%s\n' "${fdinfo_files[@]}" | LC_ALL=C awk -v known_ids="$known_ids" '
    BEGIN {
      count = split(known_ids, ids, ",")
      for (item = 1; item <= count; item++) known[tolower(ids[item])] = 1
    }

    function byte_value(amount, unit) {
      if (unit == "KiB") return amount * 1024
      if (unit == "MiB") return amount * 1024 * 1024
      if (unit == "GiB") return amount * 1024 * 1024 * 1024
      return amount
    }

    function reset_file() {
      client = ""
      pdev = ""
      delete resident
      delete busy
      delete total
      delete capacity
      delete counter_kind
    }

    function parse_line(line, fields, key, region, engine) {
      split(line, fields, /[[:space:]]+/)
      key = fields[1]
      sub(/:$/, "", key)
      if (key == "drm-client-id") client = fields[2]
      else if (key == "drm-pdev") pdev = tolower(fields[2])
      else if (key ~ /^drm-resident-/) {
        region = key
        sub(/^drm-resident-/, "", region)
        resident[region] = byte_value(fields[2] + 0, fields[3])
      } else if (key ~ /^drm-engine-capacity-/) {
        engine = key
        sub(/^drm-engine-capacity-/, "", engine)
        capacity[engine] = fields[2] + 0
      } else if (key ~ /^drm-total-cycles-/) {
        engine = key
        sub(/^drm-total-cycles-/, "", engine)
        total[engine] = fields[2] + 0
      } else if (key ~ /^drm-cycles-/) {
        engine = key
        sub(/^drm-cycles-/, "", engine)
        busy[engine] = fields[2] + 0
        counter_kind[engine] = "cycles"
      } else if (key ~ /^drm-engine-/) {
        engine = key
        sub(/^drm-engine-/, "", engine)
        busy[engine] = byte_value(fields[2] + 0, fields[3])
        counter_kind[engine] = "time"
      }
    }

    function finish_file(client_key, region, engine) {
      client_key = pdev SUBSEP client
      if (!(pdev in known) || client == "" || (client_key in seen_client)) return
      seen_client[client_key] = 1

      for (region in resident) {
        if (region ~ /(vram|local)/) {
          dedicated_memory[pdev] += resident[region]
          dedicated_seen[pdev] = 1
        } else {
          shared_memory[pdev] += resident[region]
          shared_seen[pdev] = 1
        }
      }
      for (engine in busy) {
        if (counter_kind[engine] == "cycles" && !(engine in total)) continue
        printf "engine\t%s\t%s\t%s\t%.0f\t%.0f\t%.0f\t%s\n", \
          pdev, client, engine, busy[engine], \
          (counter_kind[engine] == "cycles" ? total[engine] : -1), \
          (capacity[engine] > 0 ? capacity[engine] : 1), counter_kind[engine]
      }
    }

    {
      path = $0
      reset_file()
      while ((getline line < path) > 0) parse_line(line)
      close(path)
      finish_file()
    }

    END {
      for (pdev in dedicated_seen)
        printf "gpu-memory\t%s\tvram\t%.0f\n", pdev, dedicated_memory[pdev]
      for (pdev in shared_seen)
        printf "gpu-memory\t%s\tshared\t%.0f\n", pdev, shared_memory[pdev]
    }
  '
}

activity_process_power_stats() {
  local proc_path="/proc"
  local sys_path="/sys"
  local sample="0"
  local powercap_path zone zone_id zone_suffix zone_name energy maximum
  local -A seen_zones=()

  # This mode is designed for one exact sudoers command. A privileged
  # invocation must never honor user-controlled fixture paths.
  if (( EUID != 0 )); then
    proc_path="${OMARCHY_SYSTEM_STATS_PROC_PATH:-/proc}"
    sys_path="${OMARCHY_SYSTEM_STATS_SYS_PATH:-/sys}"
  fi

  [[ -r $proc_path/uptime ]] && read -r sample _ <"$proc_path/uptime"
  printf 'schema\tactivity-process-power\t1\n'
  printf 'sample\t%s\n' "$sample"

  powercap_path="$sys_path/class/powercap"
  for zone in \
    "$powercap_path"/*-rapl:[0-9]* \
    "$powercap_path"/*-rapl/*-rapl:[0-9]*; do
    [[ -d $zone ]] || continue
    zone_id="${zone##*/}"
    zone_suffix="${zone_id#*:}"
    [[ $zone_suffix =~ ^[0-9]+$ ]] || continue
    [[ -z ${seen_zones[$zone_id]:-} ]] || continue

    # Use only the top-level processor package. Its subdomains and PSYS
    # overlap it, while the MMIO control type is a duplicate access path.
    [[ -r $zone/name ]] || continue
    read -r zone_name <"$zone/name" 2>/dev/null || continue
    zone_name="${zone_name,,}"
    [[ $zone_name == "package" || $zone_name == package-* ]] || continue

    energy=""
    maximum=""
    [[ -r $zone/energy_uj ]] && read -r energy <"$zone/energy_uj" 2>/dev/null
    [[ -r $zone/max_energy_range_uj ]] &&
      read -r maximum <"$zone/max_energy_range_uj" 2>/dev/null
    [[ -z $energy || $energy =~ ^[0-9]+$ ]] || energy=""
    [[ -z $maximum || $maximum =~ ^[0-9]+$ ]] || maximum=""

    seen_zones["$zone_id"]=1
    printf 'package\t%s\t%s\t%s\t%s\n' \
      "$zone_id" "$zone_name" "$energy" "$maximum"
  done
}

activity_memory_speed_checked=0
activity_memory_speed_result="-1"

activity_memory_gt_to_mt() {
  local raw="$1"
  local whole fraction
  activity_memory_gt_to_mt_result="0"
  [[ $raw =~ ^([0-9]+)([.]([0-9]+))?$ ]] || return 0
  whole="${BASH_REMATCH[1]}"
  fraction="${BASH_REMATCH[3]:-}000"
  fraction="${fraction}000"
  fraction="${fraction:0:3}"
  activity_memory_gt_to_mt_result=$((10#$whole * 1000 + 10#$fraction))
}

activity_memory_speed_rows() {
  local line key value candidate
  local configured_mts=0 rated_mts=0

  if (( !activity_memory_speed_checked )); then
    activity_memory_speed_checked=1
    if command -v udevadm >/dev/null 2>&1; then
      while IFS= read -r line; do
        [[ $line == *=* ]] || continue
        key="${line%%=*}"
        value="${line#*=}"
        candidate=0
        case "$key" in
          MEMORY_DEVICE_*_CONFIGURED_SPEED_MTS)
            [[ $value =~ ^[0-9]+$ ]] && candidate="$value"
            (( candidate > 0 && (configured_mts == 0 || candidate < configured_mts) )) &&
              configured_mts="$candidate"
            ;;
          MEMORY_DEVICE_*_CONFIGURED_SPEED_GTS)
            activity_memory_gt_to_mt "$value"
            candidate="$activity_memory_gt_to_mt_result"
            (( candidate > 0 && (configured_mts == 0 || candidate < configured_mts) )) &&
              configured_mts="$candidate"
            ;;
          MEMORY_DEVICE_*_SPEED_MTS)
            [[ $value =~ ^[0-9]+$ ]] && candidate="$value"
            (( candidate > 0 && (rated_mts == 0 || candidate < rated_mts) )) &&
              rated_mts="$candidate"
            ;;
          MEMORY_DEVICE_*_SPEED_GTS)
            activity_memory_gt_to_mt "$value"
            candidate="$activity_memory_gt_to_mt_result"
            (( candidate > 0 && (rated_mts == 0 || candidate < rated_mts) )) &&
              rated_mts="$candidate"
            ;;
        esac
      done < <(
        udevadm info --query=property --path=/devices/virtual/dmi/id 2>/dev/null
      )
    fi
    if (( configured_mts > 0 )); then
      activity_memory_speed_result="$configured_mts"
    elif (( rated_mts > 0 )); then
      activity_memory_speed_result="$rated_mts"
    fi
  fi

  if (( activity_memory_speed_result > 0 )); then
    printf 'frequency\tmemory\t%s\tMT/s\n' "$activity_memory_speed_result"
  fi
}

activity_stats() {
  local proc_path="${OMARCHY_SYSTEM_STATS_PROC_PATH:-/proc}"
  local sys_path="${OMARCHY_SYSTEM_STATS_SYS_PATH:-/sys}"
  local sample="0"
  local block_stat cpu_frequency_stat
  local -a block_stats=()
  local -a cpu_frequency_stats=()
  local -a snapshot_inputs=()
  [[ -r $proc_path/uptime ]] && read -r sample _ <"$proc_path/uptime"

  printf 'schema\tactivity-resources\t1\n'
  printf 'sample\t%s\n' "$sample"
  activity_memory_speed_rows

  for block_stat in "$sys_path"/class/block/*/stat; do
    [[ -r $block_stat ]] && block_stats+=("$block_stat")
  done
  for cpu_frequency_stat in \
    "$sys_path"/devices/system/cpu/cpufreq/policy[0-9]*/scaling_cur_freq; do
    [[ -r $cpu_frequency_stat ]] && cpu_frequency_stats+=("$cpu_frequency_stat")
  done
  [[ -r $proc_path/stat ]] && snapshot_inputs+=("$proc_path/stat")
  [[ -r $proc_path/meminfo ]] && snapshot_inputs+=("$proc_path/meminfo")
  [[ -r $proc_path/loadavg ]] && snapshot_inputs+=("$proc_path/loadavg")
  [[ -r $proc_path/net/route ]] && snapshot_inputs+=("$proc_path/net/route")
  [[ -r $proc_path/net/dev ]] && snapshot_inputs+=("$proc_path/net/dev")
  if (( ${#cpu_frequency_stats[@]} == 0 )) && [[ -r $proc_path/cpuinfo ]]; then
    snapshot_inputs+=("$proc_path/cpuinfo")
  fi
  (( ${#snapshot_inputs[@]} + ${#block_stats[@]} + ${#cpu_frequency_stats[@]} > 0 )) || return 0

  # Read the fast snapshot through one awk process. Besides avoiding repeated
  # startup costs, this keeps the route decision ahead of network rows and
  # filters block devices before they cross the shell/QML boundary.
  LC_ALL=C awk \
    -v stat_path="$proc_path/stat" \
    -v meminfo_path="$proc_path/meminfo" \
    -v loadavg_path="$proc_path/loadavg" \
    -v route_path="$proc_path/net/route" \
    -v netdev_path="$proc_path/net/dev" \
    -v cpuinfo_path="$proc_path/cpuinfo" \
    -v cpufreq_root="$sys_path/devices/system/cpu/cpufreq/" \
    -v block_root="$sys_path/class/block/" \
    -v net_root="$sys_path/class/net/" '
      FILENAME == stat_path {
        # user and nice already include guest time, so expose only the
        # non-duplicated fields through steal.
        if ($1 ~ /^cpu([0-9]+)?$/) {
          total = 0
          for (field = 2; field <= 9; field++) total += $field
          printf "cpu\t%s\t%.0f\t%.0f\n", $1, total, $5 + $6
        }
        next
      }

      FILENAME == meminfo_path {
        if ($1 == "MemTotal:") memory_total = $2
        else if ($1 == "MemAvailable:") memory_available = $2
        else if ($1 == "SwapTotal:") swap_total = $2
        else if ($1 == "SwapFree:") swap_free = $2
        else if ($1 == "Cached:") memory_cached = $2
        else if ($1 == "SReclaimable:") memory_sreclaimable = $2
        next
      }

      FILENAME == loadavg_path {
        split($4, tasks, "/")
        printf "tasks\t%s\t%s\n", tasks[1], tasks[2]
        next
      }

      index(FILENAME, cpufreq_root) == 1 {
        if ($1 ~ /^[0-9]+([.][0-9]+)?$/) {
          cpu_frequency_sum += $1 / 1000
          cpu_frequency_count++
        }
        next
      }

      FILENAME == cpuinfo_path {
        if ($1 == "cpu" && $2 == "MHz" && $4 ~ /^[0-9]+([.][0-9]+)?$/) {
          cpu_frequency_sum += $4
          cpu_frequency_count++
        }
        next
      }

      FILENAME == route_path {
        if (FNR > 1 && $2 == "00000000" && $8 == "00000000" &&
            and(strtonum("0x" $4), 1)) {
          current_metric = $7 + 0
          if (!route_found || current_metric < route_metric) {
            route_found = 1
            route_metric = current_metric
            default_interface = $1
          }
        }
        next
      }

      FILENAME == netdev_path {
        if (FNR <= 2) next
        interface = $1
        sub(/:$/, "", interface)
        if (!interface || interface == "lo") next

        state = "unknown"
        state_path = net_root interface "/operstate"
        if ((getline state_value < state_path) > 0) state = state_value
        close(state_path)

        physical = 0
        device_path = net_root interface "/device/uevent"
        if ((getline device_value < device_path) > 0) physical = 1
        close(device_path)

        printf "network\t%s\t%s\t%s\t%s\t%s\t%s\n",
          interface, $2, $10, state,
          interface == default_interface ? 1 : 0, physical
        next
      }

      index(FILENAME, block_root) == 1 {
        block_path = FILENAME
        sub(/\/stat$/, "", block_path)
        name = block_path
        sub(/^.*\//, "", name)
        if (name ~ /^(loop|ram|zram)/) next

        partition_path = block_path "/partition"
        is_partition = (getline partition_value < partition_path) > 0
        close(partition_path)
        if (is_partition) next

        device_path = block_path "/device/uevent"
        physical = (getline device_value < device_path) > 0
        close(device_path)
        if (!physical) next

        major_minor = ""
        dev_path = block_path "/dev"
        if ((getline dev_value < dev_path) > 0) major_minor = dev_value
        close(dev_path)

        printf "disk\t%s\t%s\t%s\t%s\n",
          major_minor, name, $3, $7
      }

      ENDFILE {
        if (FILENAME == meminfo_path) {
          printf "memory\t%s\t%s\t%s\t%s\t%s\n",
            memory_total, memory_available, swap_total, swap_free,
            memory_cached + memory_sreclaimable
        }
      }

      END {
        if (cpu_frequency_count > 0)
          printf "frequency\tcpu\t%.0f\tMHz\n", cpu_frequency_sum / cpu_frequency_count
      }
    ' \
    "${snapshot_inputs[@]}" \
    "${block_stats[@]}" \
    "${cpu_frequency_stats[@]}"

  return 0
}

activity_process_collector="${BASH_SOURCE[0]%/*}/activity-process-stats"
activity_process_reader_pid=""
activity_process_reader_input=""
activity_process_reader_output=""

activity_process_stats() {
  if [[ ! -x $activity_process_collector ]]; then
    echo "Activity Monitor process collector is missing: $activity_process_collector" >&2
    return 1
  fi
  "$activity_process_collector"
}

activity_process_reader_stop() {
  if [[ $activity_process_reader_input =~ ^[0-9]+$ ]]; then
    { exec {activity_process_reader_input}>&-; } 2>/dev/null || true
  fi
  if [[ $activity_process_reader_output =~ ^[0-9]+$ ]]; then
    { exec {activity_process_reader_output}<&-; } 2>/dev/null || true
  fi
  if [[ $activity_process_reader_pid =~ ^[0-9]+$ ]]; then
    wait "$activity_process_reader_pid" 2>/dev/null || true
  fi

  activity_process_reader_pid=""
  activity_process_reader_input=""
  activity_process_reader_output=""
}

activity_process_reader_start() {
  activity_process_reader_stop
  if [[ ! -x $activity_process_collector ]]; then
    echo "Activity Monitor process collector is missing: $activity_process_collector" >&2
    return 1
  fi
  coproc ACTIVITY_PROCESS_READER {
    exec "$activity_process_collector" --reader
  }
  activity_process_reader_pid="$ACTIVITY_PROCESS_READER_PID"
  activity_process_reader_input="${ACTIVITY_PROCESS_READER[1]}"
  activity_process_reader_output="${ACTIVITY_PROCESS_READER[0]}"
}

activity_process_reader_snapshot_once() {
  local line
  local -a frame=()

  printf 'sample\n' >&"$activity_process_reader_input" || return 1
  while IFS= read -r -u "$activity_process_reader_output" line; do
    if [[ $line == $'snapshot-end\tprocesses' ]]; then
      (( ${#frame[@]} > 0 )) && printf '%s\n' "${frame[@]}"
      return 0
    fi
    frame+=("$line")
  done
  return 1
}

activity_process_reader_snapshot() {
  local attempt

  for attempt in 1 2; do
    if [[ ! $activity_process_reader_pid =~ ^[0-9]+$ ]]; then
      activity_process_reader_start || continue
    fi
    activity_process_reader_snapshot_once && return 0
    activity_process_reader_stop
  done

  # Keep the monitor useful if its long-lived helper cannot be started.
  activity_process_stats
}

activity_reader() {
  local request

  while IFS= read -r request; do
    case "$request" in
      resources)
        activity_stats
        ;;
      processes)
        activity_process_reader_snapshot
        ;;
      thermals)
        activity_thermal_stats
        ;;
      gpus)
        activity_gpu_stats
        ;;
      storage)
        activity_storage_stats
        ;;
      *)
        continue
        ;;
    esac
    printf 'snapshot-end\t%s\n' "$request"
  done

  activity_process_reader_stop
}

activity_process_power_reader() {
  local request

  while IFS= read -r request; do
    [[ $request == "sample" ]] || continue
    activity_process_power_stats
    printf 'snapshot-end\tpower\n'
  done
}

case "${1:-}" in
  "")
    ;;
  --bar-widget)
    bar_widget_stats
    exit
    ;;
  --activity-reader)
    activity_reader
    exit
    ;;
  --activity-resources)
    activity_stats
    exit
    ;;
  --activity-processes)
    activity_process_stats
    exit
    ;;
  --activity-thermals)
    activity_thermal_stats
    exit
    ;;
  --activity-gpus)
    activity_gpu_stats
    exit
    ;;
  --activity-process-power)
    activity_process_power_stats
    exit
    ;;
  --activity-process-power-reader)
    activity_process_power_reader
    exit
    ;;
  --activity-storage)
    activity_storage_stats
    exit
    ;;
  *)
    echo "Usage: activity-stats [--bar-widget|--activity-reader|--activity-resources|--activity-processes|--activity-thermals|--activity-gpus|--activity-process-power|--activity-process-power-reader|--activity-storage]" >&2
    exit 1
    ;;
esac

cpu=$(top -bn1 | awk '/^%?Cpu/ {
  gsub(/,/, "")
  for (i = 1; i <= NF; i++) {
    if ($(i + 1) == "id") {
      printf "%.0f%%", 100 - $i
      exit
    }
  }
}')

awk -v cpu="$cpu" '
  /^MemTotal:/ { total = $2 }
  /^MemAvailable:/ { avail = $2 }
  END {
    used = total - avail
    printf "cpu\t%s\n", cpu
    printf "memory\t%.1fGB / %.0fGB\n", used / 1024 / 1024, total / 1024 / 1024
  }
' /proc/meminfo
